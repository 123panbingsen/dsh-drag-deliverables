{
  "name": "dsh-drag-deliverables",
  "version": "0.1.0",
  "private": true,
  "description": "把交付文件卡片拖到桌面/文件夹/其他应用，也可点击保存副本。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "patch/*",
    "tools/*",
    "shell/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-deliverables"
      ]
    }
  }
}
